{
  "manifest_version": 3,
  "name": "Glance Focus",
  "version": "0.1.0",
  "description": "Local focus sessions, distraction blocking, and optional website usage insights. No account required.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging"
  ],
  "optional_permissions": [
    "tabs",
    "idle"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Glance Focus",
    "default_icon": {
      "16": "icons/outline-16.png",
      "32": "icons/outline-32.png",
      "48": "icons/outline-48.png",
      "128": "icons/outline-128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/outline-16.png",
    "32": "icons/outline-32.png",
    "48": "icons/outline-48.png",
    "128": "icons/outline-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "incognito": "not_allowed",
  "externally_connectable": {
    "matches": [
      "https://glance-notch.vercel.app/extension/dashboard/*"
    ]
  }
}
